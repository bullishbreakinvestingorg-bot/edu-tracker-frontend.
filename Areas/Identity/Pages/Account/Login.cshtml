```cshtml
@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<style>
    .edu-login {
        min-height: 82vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
        background: linear-gradient(135deg, #eef4ff, #f8faff);
        font-family: Arial, sans-serif;
    }

    .edu-login-card {
        width: 100%;
        max-width: 440px;
        background: #fff;
        padding: 38px;
        border-radius: 22px;
        box-shadow: 0 18px 55px rgba(29, 55, 110, 0.12);
        border: 1px solid #e8edfa;
    }

    .edu-brand {
        text-align: center;
        margin-bottom: 30px;
    }

    .edu-logo {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        border-radius: 17px;
        color: white;
        background: linear-gradient(135deg, #315bea, #7048e8);
        font-size: 27px;
        font-weight: 800;
    }

    .edu-brand h1 {
        font-size: 29px;
        font-weight: 800;
        color: #172554;
        margin: 0 0 8px;
    }

    .edu-brand p {
        color: #718096;
        font-size: 14px;
        margin: 0;
    }

    .edu-login .form-label {
        font-size: 14px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 8px;
    }

    .edu-login .form-control {
        min-height: 48px;
        border-radius: 10px;
        border: 1px solid #dbe3f0;
        padding: 12px 14px;
        box-shadow: none;
    }

    .edu-login .form-control:focus {
        border-color: #526cf0;
        box-shadow: 0 0 0 3px rgba(82, 108, 240, 0.12);
    }

    .edu-login .form-check-input {
        cursor: pointer;
    }

    .edu-submit {
        width: 100%;
        min-height: 49px;
        border: none;
        border-radius: 11px;
        background: linear-gradient(100deg, #315bea, #7048e8);
        color: #fff;
        font-size: 16px;
        font-weight: 700;
        transition: transform .2s, box-shadow .2s;
    }

    .edu-submit:hover {
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(66, 83, 220, .25);
    }

    .edu-links {
        text-align: center;
        margin-top: 23px;
        font-size: 14px;
    }

    .edu-links a {
        color: #4059d9;
        text-decoration: none;
        font-weight: 600;
    }

    .edu-links a:hover {
        text-decoration: underline;
    }

    .edu-links p {
        margin: 13px 0 0;
        color: #718096;
    }

    .edu-divider {
        border: 0;
        border-top: 1px solid #edf0f7;
        margin: 24px 0 0;
    }

    @@media (max-width: 480px) {
        .edu-login-card {
            padding: 27px 21px;
        }

        .edu-brand h1 {
            font-size: 25px;
        }
    }
</style>

<div class="edu-login">
    <div class="edu-login-card">
        <div class="edu-brand">
            <div class="edu-logo">E</div>
            <h1>Welcome back!</h1>
            <p>Sign in to continue to your EduTrack account.</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"
                 role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email address</label>
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="you@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Enter your password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <label asp-for="Input.RememberMe"
                       class="form-check-label d-flex align-items-center gap-2">
                    <input class="form-check-input mt-0"
                           asp-for="Input.RememberMe" />
                    Remember me
                </label>

                <a id="forgot-password"
                   asp-page="./ForgotPassword"
                   style="font-size:13px;text-decoration:none;">
                    Forgot password?
                </a>
            </div>

            <button id="login-submit" type="submit" class="edu-submit">
                Sign In
            </button>

            <hr class="edu-divider" />

            <div class="edu-links">
                <p>
                    New to EduTrack?
                    <a asp-page="./Register"
                       asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
                </p>

                <p>
                    <a id="resend-confirmation"
                       asp-page="./ResendEmailConfirmation">
                        Resend email confirmation
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
```