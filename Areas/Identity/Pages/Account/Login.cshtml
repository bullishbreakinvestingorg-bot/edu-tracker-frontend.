@page
@model EduTracker.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Login";
}

<style>
    .login-page {
        max-width: 420px;
        margin: 60px auto;
        padding: 32px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 10px 35px rgba(0,0,0,.08);
        color: #202b45;
    }
    .login-page h1 { text-align: center; margin-bottom: 8px; }
    .login-page p { text-align: center; color: #667085; }
    .login-page label { display: block; margin: 16px 0 6px; }
    .login-page input[type="email"],
    .login-page input[type="password"] {
        width: 100%;
        padding: 12px;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        box-sizing: border-box;
    }
    .login-page .remember { margin-top: 16px; }
    .login-page button {
        width: 100%;
        margin-top: 20px;
        padding: 12px;
        border: 0;
        border-radius: 8px;
        background: #526ee8;
        color: white;
        font-weight: 600;
        cursor: pointer;
    }
    .login-page .links { margin-top: 20px; text-align: center; }
    .login-page a { color: #526ee8; }
    .validation { color: #c62828; }
</style>

<div class="login-page">
    <h1>Welcome Back</h1>
    <p>Sign in to your EduTrack account</p>

    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <label asp-for="Input.Email">Email Address</label>
        <input asp-for="Input.Email" type="email" autocomplete="username"
               placeholder="Enter your email" />
        <span asp-validation-for="Input.Email" class="validation"></span>

        <label asp-for="Input.Password">Password</label>
        <input asp-for="Input.Password" type="password"
               autocomplete="current-password" placeholder="Enter your password" />
        <span asp-validation-for="Input.Password" class="validation"></span>

        <div class="remember">
            <input asp-for="Input.RememberMe" />
            <label asp-for="Input.RememberMe" style="display:inline">
                Remember me
            </label>
        </div>

        <button type="submit">Sign In</button>
    </form>

    <div class="links">
        <p><a asp-page="./Register">Create an account</a></p>
        <p><a asp-page="./ForgotPassword">Forgot password?</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
