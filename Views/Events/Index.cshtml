@model List<EduTrack.Models.Event>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Manage Events</h2>
    <a asp-action="Create" class="btn btn-primary">
        + Create Event
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <h5>No events created yet</h5>
            <p class="text-muted">
                Create an event and mark attendance for your class.
            </p>
            <a asp-action="Create" class="btn btn-primary">
                Create Your First Event
            </a>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Event Name</th>
                    <th>Date</th>
                    <th>Class</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.Name</td>
                        <td>@e.Date.ToString("dd MMM yyyy")</td>
                        <td>@e.Classroom?.Name</td>
                        <td>
                            <a asp-action="Attendance"
                               asp-route-id="@e.Id"
                               class="btn btn-sm btn-success">
                                Mark Attendance
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-controller="Dashboard"
   asp-action="Index"
   class="btn btn-outline-secondary mt-3">
    Back to Dashboard
</a>

