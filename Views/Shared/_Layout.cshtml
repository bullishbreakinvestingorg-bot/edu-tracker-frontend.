
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EduTrack</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --background: #f5f7fb;
            --text: #1e293b;
            --muted: #64748b;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            font-family: Arial, Helvetica, sans-serif;
            background: var(--background);
            color: var(--text);
        }

        /* Navigation */
        .edu-navbar {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            box-shadow: 0 2px 12px rgba(15, 23, 42, 0.04);
        }

        .edu-brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--text);
            font-size: 1.35rem;
            font-weight: 700;
            text-decoration: none;
        }

        .edu-brand:hover {
            color: var(--primary);
        }

        .edu-brand-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: var(--primary);
            color: #ffffff;
        }

        .edu-navbar .nav-link {
            padding: 9px 13px;
            margin: 3px;
            border-radius: 8px;
            color: #475569;
            font-weight: 500;
        }

        .edu-navbar .nav-link:hover {
            background: #eff6ff;
            color: var(--primary);
        }

        .edu-user {
            color: var(--muted) !important;
            font-size: 0.9rem;
        }

        .edu-logout-button {
            border: 0;
            background: transparent;
            font: inherit;
            cursor: pointer;
            width: 100%;
            text-align: left;
        }

        /* Main content */
        .edu-main {
            flex: 1;
            width: 100%;
            padding-top: 28px;
            padding-bottom: 40px;
        }

        /* Buttons */
        .btn-primary {
            background-color: var(--primary);
            border-color: var(--primary);
        }

        .btn-primary:hover {
            background-color: var(--primary-dark);
            border-color: var(--primary-dark);
        }

        /* Cards */
        .card {
            border: 1px solid #e8edf5;
            border-radius: 14px;
            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
        }

        /* Footer */
        .edu-footer {
            padding: 18px 12px;
            border-top: 1px solid #e2e8f0;
            background: #ffffff;
            color: var(--muted);
            text-align: center;
            font-size: 0.9rem;
        }

        /* Mobile layout */
        @@media (max-width: 767.98px) {
            .edu-main {
                padding-top: 18px;
                padding-bottom: 28px;
            }

            .edu-brand {
                font-size: 1.2rem;
            }

            .edu-brand-icon {
                width: 36px;
                height: 36px;
            }

            .edu-navbar .navbar-nav {
                padding-top: 8px;
            }

            .edu-navbar .nav-link {
                margin-left: 0;
                margin-right: 0;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation bar -->
    <nav class="navbar navbar-expand-md edu-navbar">
        <div class="container-fluid px-3 px-lg-4">

            <a class="edu-brand"
               asp-controller="Dashboard"
               asp-action="Index">
                <span class="edu-brand-icon">E</span>
                <span>EduTrack</span>
            </a>

            <!-- Mobile menu button -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#eduNavigation"
                    aria-controls="eduNavigation"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="eduNavigation">

                <!-- Main links -->
                <ul class="navbar-nav me-auto ms-md-3">

                    @if (User.Identity != null &&
                         User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Dashboard"
                               asp-action="Index">Dashboard</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Classes"
                               asp-action="Index">Classes</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Events"
                               asp-action="Index">Events</a>
                        </li>
                    }

                </ul>

                <!-- Account links -->
                <ul class="navbar-nav align-items-md-center">

                    @if (User.Identity != null &&
                         User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link edu-user">
                                Hello, @(User.Identity.Name ?? "User")!
                            </span>
                        </li>

                        <li class="nav-item">
                            <form method="post"
                                  asp-area="Identity"
                                  asp-page="/Account/Logout"
                                  asp-route-returnUrl="/">
                                <button type="submit"
                                        class="nav-link edu-logout-button">
                                    Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area="Identity"
                               asp-page="/Account/Login">Login</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area="Identity"
                               asp-page="/Account/Register">Register</a>
                        </li>
                    }

                </ul>

            </div>
        </div>
    </nav>

    <!-- Page content -->
    <main role="main" class="container-fluid px-3 px-lg-4 edu-main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="edu-footer">
        <div class="container">
            &copy; @DateTime.Now.Year EduTrack. All rights reserved.
        </div>
    </footer>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
